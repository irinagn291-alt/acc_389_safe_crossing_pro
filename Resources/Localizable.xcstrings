    },
    "family_detail": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This is an introduction for ages 4–9, not a test of readiness to cross alone. Cross with an adult, use designated crossings, obey local pedestrian signals, and check all directions for moving and turning vehicles. Keep looking while crossing. A green signal or a crossing never guarantees that a driver has stopped."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine Einführung für 4–9 Jahre, kein Nachweis zum alleinigen Überqueren. Mit einem Erwachsenen gehen, Übergänge nutzen, örtliche Fußgängersignale beachten und in alle Richtungen auf fahrende und abbiegende Fahrzeuge achten. Auch beim Überqueren weiter schauen. Grün und Übergänge garantieren nicht, dass Fahrzeuge halten."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une initiation pour les 4–9 ans, pas une preuve d’aptitude à traverser seul. Traversez avec un adulte, utilisez les passages, respectez les signaux locaux et observez les véhicules de tous les côtés, y compris ceux qui tournent. Continuez à regarder en traversant. Un signal vert ou un passage ne garantit jamais l’arrêt d’un conducteur."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Uma introdução para crianças de 4 a 9 anos, sem avaliar se podem atravessar sozinhas. Atravessem com um adulto, usem as faixas, obedeçam aos sinais locais para pedestres e observem veículos de todas as direções, incluindo os que viram. Continuem olhando durante a travessia. Sinal verde ou faixa nunca garantem que o motorista parou."
          }
        }
      }
    },
    "certificate_limit": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Certificates celebrate practice in this app. They are not official road-safety qualifications."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Urkunden würdigen Übungen in dieser App. Sie sind keine offiziellen Verkehrssicherheitsnachweise."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les certificats célèbrent la pratique dans l’app. Ils ne constituent pas une qualification officielle."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os certificados celebram a prática no app. Eles não são qualificações oficiais de segurança no trânsito."
          }
        }
      }
    },
    "safety_source": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Safety basis: NHTSA, Pedestrian Safety and Pedestrian Safety Rules for the Family. Learning illustrations are original and simplified."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sicherheitsgrundlage: NHTSA, Pedestrian Safety und Pedestrian Safety Rules for the Family. Eigene, vereinfachte Lernbilder."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Référence : NHTSA, Pedestrian Safety et Pedestrian Safety Rules for the Family. Illustrations originales simplifiées."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Referência: NHTSA, Pedestrian Safety e Pedestrian Safety Rules for the Family. Ilustrações originais simplificadas."
          }
        }
      }
    },
    "privacy": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Privacy & device data"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Datenschutz und Gerätedaten"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Confidentialité et données"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Privacidade e dados"
          }
        }
      }
    },
    "privacy_detail": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No data is collected or sent. No accounts, analytics, advertising, tracking, network requests or cloud storage. Choices, completion dates and reminder settings stay on this device. Removing the app removes its local progress; widgets share its App Group storage."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Es werden keine Daten erhoben oder gesendet. Keine Konten, Analysen, Werbung, Verfolgung, Netzwerkanfragen oder Cloudspeicherung. Antworten, Abschlussdaten und Erinnerungen bleiben auf diesem Gerät. Beim Entfernen der App wird der lokale Fortschritt entfernt; Widgets nutzen den gemeinsamen App-Gruppenspeicher."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucune donnée n’est collectée ni envoyée. Sans compte, analyse, publicité, suivi, requête réseau ni cloud. Les choix, dates et réglages restent sur cet appareil. Supprimer l’app retire le suivi local ; les widgets partagent son stockage App Group."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Nenhum dado é coletado ou enviado. Sem contas, análises, anúncios, rastreamento, solicitações de rede ou nuvem. Escolhas, datas e configurações ficam neste aparelho. Remover o app remove o progresso local; os widgets usam o armazenamento compartilhado do App Group."
          }
        }
      }
    },
    "widget_detail": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Widgets read local progress without internet. Widget updates are scheduled by the system."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Widgets lesen den lokalen Fortschritt ohne Internet. Das System plant Aktualisierungen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les widgets lisent le suivi local sans Internet. Le système planifie leurs mises à jour."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os widgets leem o progresso local sem internet. O sistema agenda as atualizações."
          }
        }
      }
    },
    "notification_detail": {
      "localizations": {
