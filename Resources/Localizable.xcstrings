    "sign_variations": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "These are simplified learning symbols. Real signs and rules vary by country. Ask a grown-up about your local streets."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dies sind vereinfachte Lernzeichen. Echte Zeichen und Regeln unterscheiden sich je nach Land. Frage einen Erwachsenen nach euren Straßen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ces symboles sont simplifiés. Les panneaux et les règles varient selon les pays. Demande à un adulte de t’expliquer les rues près de chez toi."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Estes símbolos são simplificados. As placas e as regras variam por país. Pergunte a um adulto sobre as ruas da sua região."
          }
        }
      }
    },
    "awards_intro": {
