            "value": "Ein Weg für Fußgänger"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un chemin pour les piétons"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Um caminho para pedestres"
          }
        }
      }
    },
    "play_road": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A place to play in the road"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Spielplatz auf der Straße"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un endroit pour jouer sur la route"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Um lugar para brincar na rua"
          }
        }
      }
    },
    "cross_mean": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A place to cross with care and an adult"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Übergang mit Vorsicht und einem Erwachsenen"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un passage à utiliser prudemment avec un adulte"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Um local para atravessar com cuidado e um adulto"
          }
        }
      }
    },
    "school_mean": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Drivers should watch for children"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Fahrzeuge sollen auf Kinder achten"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les conducteurs doivent surveiller les enfants"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Motoristas devem prestar atenção às crianças"
          }
        }
      }
    },
    "p_red": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The pedestrian signal is red. What do we do?"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Fußgängersignal ist rot. Was tun wir?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le signal piéton est rouge. Que faire ?"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O sinal para pedestres está vermelho. O que fazemos?"
          }
        }
      }
    },
    "w_red": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Red means do not start. Stay safely on the pavement with your grown-up."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Rot heißt: nicht losgehen. Bleibe mit einem Erwachsenen sicher auf dem Gehweg."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le rouge signifie de ne pas partir. Reste sur le trottoir avec ton adulte."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Vermelho significa não começar. Fique na calçada com seu adulto."
          }
        }
      }
    },
    "p_green": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Now the walking signal is on. What comes next?"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Jetzt leuchtet das Gehen-Signal. Was kommt als Nächstes?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le signal piéton passe au vert. Et maintenant ?"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Agora o sinal de pedestres está verde. E agora?"
          }
        }
      }
    },
    "w_look": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A walking signal is not a promise that cars have stopped. Check every direction, including turning vehicles, with your grown-up."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Gehen-Signal garantiert nicht, dass Autos halten. Prüfe mit einem Erwachsenen alle Richtungen, auch abbiegende Fahrzeuge."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un signal vert ne garantit pas l’arrêt des voitures. Avec ton adulte, regarde partout, y compris les véhicules qui tournent."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O sinal verde não garante que os carros pararam. Com seu adulto, olhe em todas as direções, incluindo os veículos que viram."
          }
        }
      }
    },
    "p_walk": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your grown-up has checked it is safe. How do we cross?"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Erwachsener hat geprüft, dass es sicher ist. Wie gehen wir?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ton adulte a vérifié que le passage est sûr. Comment traverser ?"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Seu adulto verificou que está seguro. Como atravessamos?"
          }
        }
      }
    },
    "w_walk": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Walk together and keep checking for traffic until you reach the other pavement. Do not run."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Geht gemeinsam und achtet bis zum anderen Gehweg weiter auf den Verkehr. Nicht rennen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Marchez ensemble et continuez à surveiller la circulation jusqu’à l’autre trottoir. Ne courez pas."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Caminhem juntos e continuem observando o trânsito até a outra calçada. Não corram."
          }
        }
      }
    },
    "p_cross": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "We want to reach the other side. Where should we go?"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wir wollen auf die andere Seite. Wohin gehen wir?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Nous voulons aller en face. Où aller ?"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Queremos chegar ao outro lado. Para onde vamos?"
          }
        }
      }
    },
    "w_cross": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Use a designated crossing with an adult. Parked cars can hide you from drivers and hide traffic from you."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nutze einen vorgesehenen Übergang mit einem Erwachsenen. Geparkte Autos können dich und den Verkehr verdecken."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Utilise un passage prévu avec un adulte. Les voitures garées peuvent te cacher et masquer la circulation."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Use uma travessia indicada com um adulto. Carros estacionados podem esconder você e o trânsito."
          }
        }
      }
    },
    "p_vehicles": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "We are at the crossing. Cars are approaching. What now?"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wir sind am Übergang. Autos kommen näher. Was nun?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Nous sommes au passage. Des voitures approchent. Et maintenant ?"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Estamos na faixa. Carros se aproximam. E agora?"
          }
        }
      }
    },
    "w_vehicles": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Do not assume drivers will stop. Wait with your adult and check all lanes and turning traffic before crossing."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nimm nicht an, dass Fahrzeuge halten. Warte mit einem Erwachsenen und prüfe alle Spuren und abbiegenden Verkehr."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ne suppose pas que les conducteurs s’arrêteront. Attends avec ton adulte et vérifie toutes les voies et les véhicules qui tournent."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não suponha que os motoristas vão parar. Espere com seu adulto e verifique todas as faixas e veículos que viram."
          }
        }
      }
    },
    "p_kerb": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "We have reached the edge of the pavement. Where do we stop?"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wir sind am Gehwegrand. Wo halten wir an?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Nous arrivons au bord du trottoir. Où s’arrêter ?"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Chegamos à borda da calçada. Onde paramos?"
          }
        }
      }
    },
    "w_kerb": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Stop safely back from the kerb. Your grown-up helps you find a clear view without stepping into danger."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Halte sicher hinter dem Bordstein. Ein Erwachsener hilft dir, sicher freie Sicht zu finden."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Arrête-toi en retrait du bord. Ton adulte t’aide à trouver une vue dégagée sans te mettre en danger."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Pare afastado da borda. Seu adulto ajuda a encontrar boa visibilidade sem entrar em perigo."
          }
        }
      }
    },
    "p_hold": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The pavement is busy. How do we stay together?"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Gehweg ist voll. Wie bleiben wir zusammen?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le trottoir est animé. Comment rester ensemble ?"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A calçada está movimentada. Como ficamos juntos?"
          }
        }
      }
    },
    "w_hold": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Stay close to your grown-up and hold hands. Never go into the road alone."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bleibe nah bei einem Erwachsenen und halte die Hand. Gehe nie allein auf die Straße."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Reste près de ton adulte et tiens-lui la main. Ne va jamais seul sur la route."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Fique perto do seu adulto e segure sua mão. Nunca vá para a rua sozinho."
          }
        }
      }
    },
    "p_focus": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A screen is distracting us near the road. What helps?"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Bildschirm lenkt uns an der Straße ab. Was hilft?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un écran nous distrait près de la route. Que faire ?"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Uma tela nos distrai perto da rua. O que ajuda?"
          }
        }
      }
    },
    "w_focus": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Put screens and other distractions away. Listen and look for traffic with your grown-up."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Lege Bildschirme und andere Ablenkungen weg. Höre und schaue gemeinsam nach Verkehr."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Range les écrans et les distractions. Écoute et observe la circulation avec ton adulte."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Guarde telas e outras distrações. Escute e observe o trânsito com seu adulto."
          }
        }
      }
    },
    "p_visible": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "It is getting darker. What helps people see us?"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Es wird dunkler. Wie sind wir besser sichtbar?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Il fait plus sombre. Comment être visible ?"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Está escurecendo. O que ajuda as pessoas a nos ver?"
          }
        }
      }
    },
    "w_visible": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Visible clothing can help, but it never makes crossing automatically safe. Stay with your adult and check traffic."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sichtbare Kleidung kann helfen, macht Übergänge aber nie automatisch sicher. Bleibe beim Erwachsenen und prüfe den Verkehr."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Des vêtements visibles peuvent aider, sans rendre une traversée automatiquement sûre. Reste avec ton adulte et vérifie la circulation."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Roupas visíveis podem ajudar, mas não tornam a travessia automaticamente segura. Fique com seu adulto e verifique o trânsito."
          }
        }
      }
    },
    "p_slip": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Snow has made the pavement slippery. How do we move?"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schnee macht den Gehweg glatt. Wie gehen wir?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La neige rend le trottoir glissant. Comment avancer ?"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A neve deixou a calçada escorregadia. Como andamos?"
          }
        }
      }
    },
    "w_slip": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Walk carefully with your adult and stay back from the road. Vehicles can also need more time to stop in bad weather."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gehe vorsichtig mit einem Erwachsenen und bleibe von der Straße zurück. Bei schlechtem Wetter brauchen auch Fahrzeuge mehr Zeit zum Halten."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Marche prudemment avec ton adulte et loin du bord. Par mauvais temps, les véhicules peuvent aussi mettre plus de temps à s’arrêter."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ande com cuidado com seu adulto, longe da borda. Com mau tempo, veículos também podem precisar de mais tempo para parar."
          }
        }
      }
    },
    "q_sign": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "What does this learning symbol tell us?"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Was sagt uns dieses Lernzeichen?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Que signifie ce symbole ?"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O que este símbolo nos ensina?"
          }
        }
      }
    },
    "q_path_why": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This symbol marks a walking path. Still check carefully where it meets a driveway or road."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieses Zeichen markiert einen Fußweg. Prüfe trotzdem Einfahrten und Straßen sorgfältig."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce symbole indique un chemin piéton. Vérifie toujours les sorties de garage et les routes."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Este símbolo indica um caminho para pedestres. Observe com cuidado entradas de veículos e ruas."
          }
        }
      }
    },
    "q_school_why": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This warns drivers that children may be nearby. It does not give children permission to enter the road."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dies warnt Fahrzeuge vor Kindern. Es erlaubt Kindern nicht, auf die Straße zu gehen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce symbole avertit les conducteurs de la présence d’enfants. Il n’autorise pas les enfants à entrer sur la route."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Isso alerta motoristas sobre crianças por perto. Não autoriza crianças a entrar na rua."
          }
        }
      }
    },
    "q_stop_why": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A stop sign tells drivers to stop. Pedestrians must still check that all traffic is safe with an adult."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Stoppschild verlangt, dass Fahrzeuge halten. Fußgänger müssen trotzdem mit einem Erwachsenen den gesamten Verkehr prüfen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un panneau stop demande aux conducteurs de s’arrêter. Les piétons doivent toujours vérifier avec un adulte."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Uma placa de parada manda motoristas parar. Pedestres ainda devem verificar todo o trânsito com um adulto."
          }
        }
      }
    },
    "meadow_name": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sunny Town"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sonnenstadt"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ville ensoleillée"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Cidade do Sol"
          }
        }
      }
    },
    "meadow_season": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Spring"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Frühling"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Printemps"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Primavera"
          }
        }
      }
    },
    "meadow.0_title": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The waiting light"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Wartesignal"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le signal d’attente"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O sinal de espera"
          }
        }
      }
    },
    "meadow.1_title": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Zebra crossing"
          }
        },
        "de": {
