    "signs_intro": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Discover the signals and signs that help us share the street."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Entdecke Signale und Zeichen für gemeinsame sichere Wege."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Découvre les signaux et les panneaux qui nous guident dans la rue."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Descubra os sinais e as placas que nos orientam na rua."
          }
